# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Auth rate limit
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# JWT
JWT_ACCESS_SECRET=replace_with_access_token_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=1h

# Password hashing
BCRYPT_SALT_ROUNDS=10

# Firebase
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=replace_with_firebase_client_email
